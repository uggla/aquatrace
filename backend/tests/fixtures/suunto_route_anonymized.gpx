<?xml version="1.0" encoding="UTF-8"?>
<gpx creator="Suunto Routeplanner"
     version="1.1"
     xmlns="http://www.topografix.com/GPX/1/1"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xmlns:suunto-rp="http://www.suunto.com/routeplanner/gpx/1.0"
     xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Anonymized route</name>
    <desc>Route created with Suunto Routeplanner</desc>
  </metadata>
  <wpt lat="45.000000" lon="5.000000"><name>Begin</name></wpt>
  <wpt lat="45.002000" lon="5.002000"><name>End</name></wpt>
  <rte>
    <name>Anonymized route</name>
    <extensions>
      <suunto-rp:waypointIndices>0,2</suunto-rp:waypointIndices>
    </extensions>
    <rtept lat="45.000000" lon="5.000000"><ele>100</ele></rtept>
    <rtept lat="45.001000" lon="5.001000"><ele>110</ele></rtept>
    <rtept lat="45.002000" lon="5.002000"><ele>120</ele></rtept>
  </rte>
</gpx>
